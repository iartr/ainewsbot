TELEGRAM_BOT_TOKEN=123456:replace_me
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/newsbot
POLL_INTERVAL_MINUTES=15
REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
# Optional: enables instant alerts for brand-new model releases (otherwise everything
# waits for the daily digest). Uses a cheap OpenAI model to classify headlines.
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-5.4-nano
# Daily digest schedule (news other than podcasts is batched into one message).
DIGEST_HOUR=19
DIGEST_MINUTE=0
DIGEST_TIMEZONE=Europe/Moscow

